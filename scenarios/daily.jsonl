# starter scenarios (one JSON object per line). Only `opening` reaches the assistant on turn 1; everything else briefs the simulated user and the judge.
# Facts come from user.json through {name} {home} {car} {household} ...; a scenario's own "user" block can override them.
{"id": "daily/01_mechanic_mirror", "tags": ["local", "anderson-1"], "opening": "Find me a mechanic shop that can do a side mirror replacement on my car", "situation": "the driver-side mirror housing on the {car} is cracked; the registration renewal is due in 9 days and {name} wants it fixed before then; free Thursday afternoon and Saturday morning", "goal": "one or two shops near {home} that do side-mirror replacement, with hours and a rough price, ideally a slot this week", "hidden": ["lives in {home}", "car is a {car}", "registration renewal due in 9 days, wants it done before that", "budget under $250", "free Thursday afternoon or Saturday morning"], "reveal": "only when the assistant asks or clearly cannot proceed without it; one fact per reply; never volunteer the budget unless asked about price", "done_when": "the assistant named at least one concrete shop near {home} with its address and hours or a price, or proposed a booking time", "scoring": {"criteria": ["Today is {{today}}. The user wants a shop near their home ({home}) that replaces a side mirror on their {car}; location, car and deadline were not in the first message and were given only when asked (the account profile may already carry the home city). PASS if the assistant ended up naming at least one real, specific shop within about 15 minutes of {home} with an address and either hours or a price, after at most two clarifying questions. FAIL if it listed shops far away, gave only generic advice (e.g. 'search Yelp'), asked more than two questions before giving any shop, or asked the user to sign in to anything."]}}
{"id": "daily/02_pool_tomorrow", "tags": ["fitness", "anderson-15"], "opening": "Find me a pool that I can swim at tomorrow, and write me a workout", "situation": "{name} used to swim regularly, has not trained for two years and wants to get back in the water; tomorrow morning 9-11am is free; no pool membership", "goal": "a pool near {home} with drop-in access tomorrow morning, and a 45-minute intermediate workout to do there", "hidden": ["tomorrow = the real next day after today; free 9-11am", "lives in {home}", "swam regularly years ago, intermediate level, two years off", "wants 45 minutes", "no membership, wants drop-in / day pass"], "reveal": "only when asked; never dispute what day it is; if the assistant writes a beginner workout, push back once ('i used to swim a lot, make it harder'); one fact per reply", "done_when": "a named pool near {home} with tomorrow-morning drop-in hours and a 45-minute workout written as sets", "scoring": {"criteria": ["Today is {{today}}. The user wants a pool they can swim at tomorrow morning near their home ({home}), plus a workout; they are an intermediate swimmer and say so only when asked or when the workout is too easy. PASS if the assistant named at least one real pool within about 15 minutes of {home} with public or drop-in hours for tomorrow morning AND gave a swim workout written as sets with distances (not just 'swim 30 minutes'). FAIL if the pool is generic or far from {home}, the hours are missing or for the wrong day, the workout has no sets, or the assistant asked more than two questions before giving anything."]}}
{"id": "daily/03_flowers_finals", "tags": ["shop", "anderson-4"], "opening": "I want to order flowers online and send them to my GF.", "situation": "{name}'s girlfriend (see household: {household}) finishes her finals on Monday; he wants flowers delivered to her that day with a short note; no budget decided until asked; fine with the first reasonable option but will not pay in the chat", "goal": "two or three bouquet options in the $80-150 range deliverable Monday, pick one, note 'good job with finals'", "hidden": ["occasion: she finishes finals on Monday", "deliver Monday, daytime", "budget $80 to $150", "note: 'good job with finals'", "her address: same as mine ({home})"], "reveal": "only when asked; one or two facts per reply; if asked for payment details say he will pay when it is time, just show options", "done_when": "the assistant showed at least two concrete bouquet options with prices and a Monday delivery, and acknowledged the note text", "scoring": {"criteria": ["Today is {{today}}. The user wants flowers delivered to their girlfriend on Monday for finishing finals, budget $80-150, note 'good job with finals'; these details were given only when asked. PASS if the assistant presented at least two specific bouquet options with prices from a real florist or delivery service, confirmed Monday delivery is possible, and carried the note text, without asking for a card number in chat. FAIL if it gave only generic florist names, ignored the budget, asked for payment details in the conversation, or asked more than three questions before showing any option."]}, "user": {"household": "lives with girlfriend Dana, a grad student finishing her finals"}}
{"id": "daily/04_doctor_adhd", "tags": ["local", "anderson-17"], "opening": "I need to find a doctor in the area for general care, and ADHD. I need to then book an appointment", "situation": "{name} moved recently and has no primary care doctor; wants a general-care doctor who also handles ADHD (prior diagnosis, needs a prescription refill); PPO insurance through work; refuses to sign in to any patient portal or insurance site in the chat; Mondays are the light day", "goal": "a short list (3-5) of doctors or clinics near {home} that take new patients, do primary care and ADHD, with phone numbers, then help booking the earliest Monday slot", "hidden": ["lives in {home}", "PPO insurance through work (does not remember the carrier name offhand; 'blue something')", "prior ADHD diagnosis, needs a refill", "prefers Mondays, soonish", "will NOT sign in to any portal or give an insurance login; wants a list and phone numbers instead"], "reveal": "only when asked; if the assistant asks to sign in anywhere, refuse firmly and ask for a list with phone numbers instead", "done_when": "the assistant gave a list of at least three specific clinics or doctors near {home} with phone numbers and said how to book or offered to book a Monday slot without a portal login", "scoring": {"criteria": ["Today is {{today}}. The user wants a primary-care doctor near their home ({home}) who also handles ADHD, and then an appointment; the user refuses to sign in to any portal. PASS if the assistant produced at least three specific, real clinics or doctors in or near {home} with phone numbers and either booked, offered to call, or explained how to get a Monday appointment, without requiring the user to sign in. FAIL if it insisted on a portal or insurance login, gave fewer than three concrete options, listed providers far from {home}, or stalled on questions for more than two turns."]}}
{"id": "daily/05_beginner_running_plan", "tags": ["plan", "persona-free", "anderson-10"], "opening": "I want to start running but I have never run before. Make me a training plan I can share with a couple of friends.", "situation": "a persona-free planning task: whoever lives it has no running background and wants a plan they can share; the assistant will ask about goals, days per week and how to share", "goal": "a 4-8 week beginner plan (walk/run progression) laid out week by week, shareable as a page or document", "hidden": ["goal: run 5 km without stopping in about 8 weeks", "3 days a week, mornings", "no gym, just outdoors", "share it as a page or a doc link, not a PDF"], "reveal": "only when asked; one fact per reply; if the assistant proposes a marathon or more than 4 days a week, say that is too much", "done_when": "a week-by-week beginner plan exists with run/walk intervals per session and the assistant gave something shareable (a page, a doc, or a link)", "scoring": {"criteria": ["Today is {{today}}. The user is a complete beginner who wants a running plan they can share with friends; when asked they say 5 km in about 8 weeks, 3 mornings a week, outdoors, shared as a page or doc. PASS if the assistant produced a week-by-week plan with run/walk intervals per session, sized to a beginner (3 days a week, building to 5 km), and made it shareable (a page, document or link). FAIL if the plan is generic ('run 30 minutes'), too aggressive, not shareable, or the assistant asked more than three questions before producing anything."]}}
{"id": "daily/06_ev_under_40k", "tags": ["research", "persona-free", "anderson-21"], "opening": "Compare every EV under $40k with 300+ miles of range and make me a page.", "situation": "a persona-free research task: the person wants a comparison page of new EVs sold in the US under $40,000 MSRP with 300+ miles of EPA range", "goal": "a page comparing the qualifying EVs: name, MSRP, EPA range, charging, a one-line fit note each, with links", "hidden": ["new cars only, US market, 2026 model year", "MSRP before incentives", "EPA range, not manufacturer estimates", "no preference on brand; wants the table sortable by price"], "reveal": "only when asked; do not volunteer the model-year or incentive rules unless the assistant mixes them up", "done_when": "a page exists with at least five qualifying EVs in a comparison table with MSRP, EPA range and links, and the assistant shared its link", "scoring": {"criteria": ["Today is {{today}}. The user wants a comparison page of new US-market EVs under $40,000 MSRP with 300+ miles of EPA range. PASS if the assistant built a page (or document) with a table of at least five qualifying models showing MSRP and EPA range with links, and shared it. FAIL if there is no page, fewer than five models, the numbers are plainly wrong (a car over $40k or under 300 miles listed as qualifying without a note), or the assistant only answered in chat."]}}
