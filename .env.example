# Copy to .env (never committed). KEY=VALUE lines; only these keys are read.
OPENROUTER_API_KEY=            # pays for the simulated user and the judge (DeepSeek V4.1 Flash: cents per run) — the only key the Chrome path needs
CF_ACCESS_CLIENT_ID=           # eval_system endpoint only: Cloudflare Access service token for dev.hark.com
CF_ACCESS_CLIENT_SECRET=
GOOGLE_CLIENT_ID=              # optional: only for accounts that sign in with Google instead of a password
GOOGLE_CLIENT_SECRET=
